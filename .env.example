# LLM provider configuration
# Only "groq" is implemented. Adding a provider later is a change to
# services/llm_service.py, not to any code that calls it.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Logging
LOG_LEVEL=INFO

# Behavior verification (verification/tests.py) runs pytest against
# AI-generated code in a subprocess. Leave this false unless you trust
# the environment you're running in -- see README's Security notes.
ALLOW_TEST_EXECUTION=false

# RAG knowledge base
KNOWLEDGE_BASE_DIR=data/documents
VECTOR_INDEX_DIR=data/indexes
